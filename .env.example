# Шаблон переменных окружения. Скопируйте в apps/api/.env и заполните.
# Сам .env никогда не коммитится. Пустое значение = берётся значение по умолчанию (см. apps/api/src/env.ts).

# --- Общее ---
NODE_ENV=
API_PORT=
WEB_ORIGIN=
PUBLIC_URL=
UPLOAD_DIR=

# --- База данных (PostgreSQL) ---
# Локально: docker compose up -d, по умолчанию postgres://kiberdvor:kiberdvor@localhost:5432/kiberdvor
DATABASE_URL=

# --- Вход ---
# Тестовый вход без Яндекс ID (только разработка, в production запрещён): true/false
DEV_AUTH=
# Яндекс ID (OAuth): https://oauth.yandex.ru/
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Steam и игровые API ---
# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# FACEIT Data API (стартовый рейтинг CS2), необязательно
FACEIT_API_KEY=

# --- Оплата (ЮKassa) ---
# Пока не используется: подписка оформляется заглушкой.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Демо-данные (pnpm --filter api seed) ---
# Настоящий SteamID64 пользователя artem — чтобы зайти на тестовый сервер CS2 со своего Steam.
SEED_ARTEM_STEAM_ID=

# --- Telegram-бот, необязательно ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
